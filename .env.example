# Salin file ini menjadi .env lalu isi. JANGAN commit .env ke GitHub.

# Nama kamu, dipakai sebagai nama folder backup (tanpa tanda /)
NAMA_SISWA=

# Router MikroTik kamu
MT_HOST=192.168.88.1
MT_PORT=22
MT_USER=admin
MT_PASS=
# Kosongkan kalau backup tidak dienkripsi
MT_BACKUP_PASS=

# Dari instruktur
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
PUBLIC_URL=
